# Product
APP_NAME=多agent视觉感知与可解释决策

# Vision detector
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF_THRESHOLD=0.25

# Optional LLM report generation and intelligent follow-up
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local persistence
REPORTS_DIR=reports/enhanced
CACHE_ENABLED=true
CACHE_DIR=cache/detections
LOG_LEVEL=INFO
